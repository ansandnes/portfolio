# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Server-only (do NOT prefix with NEXT_PUBLIC) ---

# Google Gemini API key, from https://aistudio.google.com/apikey
# Used server-side only by the AI route handlers.
API_KEY_GEMINI=

# --- Client-exposed (NEXT_PUBLIC_*) ---

# Base URL of the Python energy-analysis service.
# Phase 2 replaces the direct browser call with a Next.js proxy route;
# after that this becomes a server-only ENERGY_SERVICE_URL instead.
NEXT_PUBLIC_API_URL=http://localhost:8000
