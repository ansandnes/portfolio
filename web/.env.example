# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Server-only (do NOT prefix with NEXT_PUBLIC) ---

# Google Gemini API key, from https://aistudio.google.com/apikey
# Used server-side only by the AI route handlers (app/api/ai/*).
API_KEY_GEMINI=

# Extra origins allowed to call the API routes, comma-separated. Same-origin is
# always allowed; use this for preview deployments. Supports one "*" per label.
# e.g. https://portfolio.example.com,https://*.vercel.app
ALLOWED_ORIGINS=

# Log level for the API route logger: debug | info | warn | error (default: info)
LOG_LEVEL=

# Reserved for the Phase 6 "build" path (the energy service is deferred for now):
# ENERGY_SERVICE_URL=https://energy.example.com
# ENERGY_SHARED_SECRET=

# --- Client-exposed (NEXT_PUBLIC_*) ---

# Canonical site URL, used for metadata (OpenGraph), sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" shows the Energy Analyzer tab in /projects. Deferred in Phase 6 — leave
# unset/false until services/energy is built and deployed.
NEXT_PUBLIC_ENERGY_ENABLED=false
